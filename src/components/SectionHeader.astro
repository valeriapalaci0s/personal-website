---
interface Props {
  /** Small uppercase label; becomes the section heading when there is no title. */
  eyebrow: string;
  /** Optional large title under the label. */
  title?: string;
  id?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, id, align = 'left' } = Astro.props;
const eyebrowClass = 'text-xs tracking-[0.2em] text-muted-foreground uppercase';
---

<div class:list={['mb-10 md:mb-14', align === 'center' && 'text-center']}>
  {
    title ? (
      <>
        <p class:list={[eyebrowClass, 'mb-3']}>{eyebrow}</p>
        <h2 id={id} class="font-heading text-5xl leading-none font-medium tracking-[-0.03em] md:text-6xl">
          {title}
        </h2>
      </>
    ) : (
      <h2 id={id} class={eyebrowClass}>
        {eyebrow}
      </h2>
    )
  }
</div>

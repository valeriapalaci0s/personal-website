---
import { Image } from 'astro:assets';
import mountains from '@/assets/placeholders/mountains.jpg';
import { pill } from '@/lib/styles';

// Placeholder copy and photo — Phase 5
const role = 'Product & Writing';
const location = 'City, 2026';
---

<section id="top" class="relative isolate flex min-h-svh flex-col justify-end overflow-hidden">
  <Image
    src={mountains}
    alt=""
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_65%]"
  />
  <!-- Keeps white type legible over any photo and fades into the page background -->
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-black/40 via-transparent via-45% to-background"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-7xl px-4 pt-24 pb-8 sm:px-6 md:pb-10">
    <h1 class="display hero-name text-white">Valeria<br />Palacios</h1>

    <div
      class="mt-8 flex items-center justify-between gap-4 text-xs font-bold tracking-wide text-white uppercase md:mt-12"
    >
      <span>{role}</span>
      <span class="hidden sm:inline">{location}</span>
      <a href="#contact" class={pill('solid')}>Contact</a>
    </div>
  </div>
</section>

<style>
  .hero-name {
    font-size: clamp(3.25rem, 15vw, 13rem);
  }
</style>

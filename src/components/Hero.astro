---
import { Image } from 'astro:assets';
import portrait from '@/assets/placeholders/hero-portrait.jpg';

const firstName = 'Valeria';
const lastName = 'Palacios';
const caption = 'City, 2026'; // placeholder — Phase 5
---

<section id="top" class="flex min-h-dvh items-center overflow-hidden pt-16">
  <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6">
    <h1 class="sr-only">{firstName} {lastName}</h1>

    <div
      class="grid grid-cols-1 items-center justify-items-center gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-8 lg:gap-12"
    >
      <span class="hero-name md:justify-self-end" aria-hidden="true">{firstName}</span>

      <figure class="w-[70vw] max-w-xs -rotate-2 bg-white p-3 pb-4 shadow-[0_10px_30px_-12px_rgb(0_0_0/0.35)] md:w-52 lg:w-72">
        <Image
          src={portrait}
          alt="Portrait of Valeria Palacios"
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 1024px) 18rem, (min-width: 768px) 13rem, 70vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-4/5 w-full object-cover"
        />
        <figcaption class="pt-3 text-center text-sm text-muted-foreground">
          {caption}
        </figcaption>
      </figure>

      <span class="hero-name md:justify-self-start" aria-hidden="true">{lastName}</span>
    </div>
  </div>
</section>

<style>
  .hero-name {
    font-family: var(--font-heading);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.9;
    font-size: clamp(3.5rem, 18vw, 6.5rem);
  }

  @media (min-width: 768px) {
    .hero-name {
      font-size: clamp(3rem, 8vw, 9.5rem);
    }
  }
</style>

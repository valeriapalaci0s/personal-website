---
import { Image } from 'astro:assets';
import portrait from '@/assets/placeholders/hero-portrait.jpg';
import detailPhoto from '@/assets/placeholders/detail-photo.jpg';
import aboutPhoto from '@/assets/placeholders/about-photo.jpg';

// Placeholder copy and photos — Phase 5
const location = 'City, 2026';
const photoSizes = '(min-width: 768px) 11rem, 7rem';
---

<section id="top" class="flex min-h-[72svh] flex-col justify-end pt-16 lg:min-h-dvh">
  <div class="mx-auto w-full max-w-6xl px-4 pb-12 sm:px-6 md:pb-20">
    <!-- Name + intro as one editorial sentence, with small photos set inline in the text -->
    <h1 class="hero-line">
      Valeria Palacios{' '}
      <span class="hero-photo hero-photo--round">
        <Image src={portrait} alt="Portrait of Valeria Palacios" widths={[160, 320]} sizes={photoSizes} loading="eager" fetchpriority="high" />
      </span>{' '}
      builds thoughtful products and writes about{' '}
      <span class="hero-photo">
        <Image src={detailPhoto} alt="" widths={[200, 400]} sizes={photoSizes} loading="eager" />
      </span>{' '}
      curiosity, craft and{' '}
      <span class="hero-photo hero-photo--tall">
        <Image src={aboutPhoto} alt="" widths={[160, 320]} sizes={photoSizes} loading="eager" />
      </span>{' '}
      everyday things.
    </h1>

    <div class="mt-12 flex items-center justify-between border-t pt-4 text-sm text-muted-foreground md:mt-16">
      <span>{location}</span>
      <a href="#about" class="underline-offset-4 transition-colors hover:text-foreground hover:underline">Scroll ↓</a>
    </div>
  </div>
</section>

<style>
  .hero-line {
    font-family: var(--font-heading);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    font-size: clamp(2.5rem, 7vw, 6.75rem);
    text-wrap: pretty;
  }

  .hero-photo {
    display: inline-block;
    height: 0.8em;
    aspect-ratio: 16 / 10;
    margin-inline: 0.04em;
    vertical-align: -0.1em;
    overflow: hidden;
    border-radius: 9999px;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hero-photo--round {
    aspect-ratio: 1;
  }

  .hero-photo--tall {
    aspect-ratio: 3 / 4;
    border-radius: 0.2em;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-photo:hover {
      transform: rotate(-4deg) scale(1.08);
    }
  }
</style>

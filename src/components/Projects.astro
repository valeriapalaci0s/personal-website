---
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getProjects } from '@/lib/projects';

const projects = await getProjects();
---

<section id="projects" aria-labelledby="projects-title" class="scroll-mt-16 border-t">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-36">
    <SectionHeader eyebrow="Projects" title="Projects" id="projects-title" />

    <ul class="grid gap-x-8 gap-y-16 md:grid-cols-2">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import { ArrowUpRightIcon } from 'lucide-react';
import CopyEmail from '@/components/CopyEmail';
import { links } from '@/data/links';
import { pill } from '@/lib/styles';
---

<section id="contact" aria-labelledby="contact-title" class="scroll-mt-16 border-t">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-40">
    <p class="mb-4 text-xs font-bold tracking-wide text-muted-foreground uppercase">Contact</p>
    <h2 id="contact-title" class="display mb-8 text-[clamp(4rem,16vw,14rem)]">Let's talk</h2>

    <!-- Placeholder copy — Phase 5 -->
    <p class="mb-10 max-w-md text-lg text-muted-foreground text-pretty">
      One line inviting people to reach out, and what about.
    </p>

    <div class="flex flex-wrap items-center gap-3">
      <CopyEmail client:visible email={links.email} />
      {
        links.social.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class={pill('outline')}>
            {link.label}
            <ArrowUpRightIcon aria-hidden="true" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

---
import { links } from '@/data/links';

const year = new Date().getFullYear();
---

<footer class="border-t">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm text-muted-foreground sm:px-6 md:flex-row md:items-center md:justify-between"
  >
    <p>© {year} Valeria Palacios</p>

    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {
        links.social.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="underline-offset-4 transition-colors hover:text-foreground hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a href="#top" class="underline-offset-4 transition-colors hover:text-foreground hover:underline">
      Back to top ↑
    </a>
  </div>
</footer>

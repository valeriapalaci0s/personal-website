---
import SectionHeader from '@/components/SectionHeader.astro';
import ExperienceAccordion from '@/components/ExperienceAccordion';
import { experience } from '@/data/experience';
---

<section id="experience" aria-labelledby="experience-title" class="scroll-mt-16 border-t">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-36">
    <SectionHeader eyebrow="Experience" title="Experience" id="experience-title" />
    <ExperienceAccordion client:visible items={experience} />
  </div>
</section>

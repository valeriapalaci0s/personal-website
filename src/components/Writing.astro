---
import { ArrowUpRightIcon } from 'lucide-react';
import SectionHeader from '@/components/SectionHeader.astro';
import { links } from '@/data/links';
import { pill } from '@/lib/styles';
---

<section id="writing" aria-labelledby="writing-title" class="scroll-mt-16 border-t">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 md:py-36">
    <SectionHeader eyebrow="Writing" title="Writing" id="writing-title" />

    <!-- Placeholder copy — Phase 5 -->
    <p class="mb-10 max-w-2xl text-lg text-muted-foreground text-pretty md:text-xl">
      I write on Substack about the topics you care about. One sentence on what readers will find
      there.
    </p>

    <a href={links.substack} target="_blank" rel="noopener noreferrer" class={pill('solid')}>
      Read on Substack
      <ArrowUpRightIcon aria-hidden="true" />
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  </div>
</section>

---
import DesktopNav from '@/components/DesktopNav';
import MobileNav from '@/components/MobileNav';
import { navItems } from '@/data/links';
---

<header
  data-site-header
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300 data-scrolled:border-white/10 data-scrolled:bg-background/80 data-scrolled:backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="text-sm font-black tracking-tight text-white uppercase">Valeria Palacios</a>

    <!-- Static HTML: plain links need no JS on desktop -->
    <div class="hidden md:block">
      <DesktopNav items={navItems} />
    </div>

    <!-- Hydrated only on small screens, where the sheet is used -->
    <div class="md:hidden">
      <MobileNav client:media="(max-width: 767px)" items={navItems} />
    </div>
  </div>
</header>

<script>
  // Transparent over the hero; gains a dark blurred background once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

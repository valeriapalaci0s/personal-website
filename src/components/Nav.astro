---
import DesktopNav from '@/components/DesktopNav';
import MobileNav from '@/components/MobileNav';
import { navItems } from '@/data/links';
---

<header class="fixed inset-x-0 top-0 z-40 border-b bg-background/85 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-heading text-2xl leading-none font-semibold tracking-tighter" aria-label="Valeria Palacios, home">VP</a>

    <!-- Static HTML: plain links need no JS on desktop -->
    <div class="hidden md:block">
      <DesktopNav items={navItems} />
    </div>

    <!-- Hydrated only on small screens, where the sheet is used -->
    <div class="md:hidden">
      <MobileNav client:media="(max-width: 767px)" items={navItems} />
    </div>
  </div>
</header>

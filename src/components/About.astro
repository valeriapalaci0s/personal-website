---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeader from '@/components/SectionHeader.astro';
import aboutPhoto from '@/assets/placeholders/about-photo.jpg';

interface Props {
  /** Optional secondary photo; pass `null` to hide it. */
  photo?: ImageMetadata | null;
}

const { photo = aboutPhoto } = Astro.props;
---

<section id="about" aria-labelledby="about-title" class="scroll-mt-16 border-t">
  <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 md:py-32">
    <SectionHeader eyebrow="About" title="Hi, I'm Valeria." id="about-title" align="center" />

    {
      photo && (
        <figure class="mx-auto mb-12 w-44 rotate-2 bg-white p-2 pb-6 shadow-[0_10px_30px_-12px_rgb(0_0_0/0.3)] md:w-52">
          <Image
            src={photo}
            alt="Photo of Valeria Palacios"
            widths={[240, 360, 480]}
            sizes="13rem"
            class="aspect-3/4 w-full object-cover"
          />
        </figure>
      )
    }

    <!-- Placeholder copy — Phase 5 -->
    <p class="text-xl leading-relaxed text-pretty md:text-2xl">
      A short bio goes here: what you do, where you're based and what you care about. Two or three
      sentences that sound like you, with one word that carries the <em
        class="font-heading text-[1.2em] text-brand">accent</em
      >.
    </p>
  </div>
</section>

---
import { Image } from 'astro:assets';
import SocialLinks from '@/components/SocialLinks.astro';
import { profile } from '@/data/profile';
import photo from '@/assets/photo-placeholder.jpg';
---

<header class="mb-12 flex flex-col items-center text-center">
  <Image
    src={photo}
    alt={`Photo of ${profile.name}`}
    width={144}
    height={144}
    loading="eager"
    class="mb-5 size-[72px] rounded-full object-cover"
  />
  <h1 class="text-xl font-extrabold tracking-tight">{profile.name}</h1>
  <p class="mt-1 font-light text-muted-foreground">
    {profile.role} · {profile.location}
  </p>

  <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
    <SocialLinks />
    {
      profile.resumeUrl && (
        <a
          href={profile.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
        >
          Resume ↗<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )
    }
  </div>
</header>

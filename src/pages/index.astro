---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/ui/button';
---

<BaseLayout>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col items-center justify-center gap-6 px-4 text-center">
    <h1 class="font-heading text-6xl uppercase sm:text-8xl">Valeria Palacios</h1>
    <p class="text-muted-foreground">
      Setup check: <em class="font-heading text-2xl text-brand">editorial</em> theme, Geist and shadcn/ui.
    </p>
    <Button>shadcn Button</Button>
  </main>
</BaseLayout>

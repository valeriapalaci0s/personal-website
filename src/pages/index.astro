---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileHeader from '@/components/ProfileHeader.astro';
import Sections from '@/components/Sections';
import { about, experience, skills, socialLinks } from '@/data/profile';
---

<BaseLayout>
  <main class="mx-auto w-full max-w-[720px] px-5 py-14 sm:px-8 md:py-24">
    <ProfileHeader />
    <Sections
      client:load
      about={about}
      skills={skills}
      experience={experience}
      socialLinks={socialLinks}
    />
  </main>
</BaseLayout>

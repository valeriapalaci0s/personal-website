---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pill } from '@/lib/styles';
---

<BaseLayout title="Page not found · Valeria Palacios">
  <section class="mx-auto flex min-h-[80svh] max-w-7xl flex-col justify-end px-4 pt-28 pb-16 sm:px-6">
    <p class="mb-4 text-xs font-bold tracking-wide text-muted-foreground uppercase">Error 404</p>
    <h1 class="display text-[clamp(4rem,18vw,16rem)]">Lost?</h1>
    <p class="mt-6 mb-10 max-w-md text-lg text-muted-foreground">This page doesn't exist, or it moved.</p>
    <div>
      <a href="/" class={pill('solid')}>Back home</a>
    </div>
  </section>
</BaseLayout>
